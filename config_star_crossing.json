{
    "model": {
        "d_model": 256,
        "nhead": 8,
        "num_encoder_layers": 6,
        "num_associate_decoder_layers": 3,
        "num_filtering_decoder_layers": 6,
        "dim_feedforward_encoder": 2048,
        "dim_feedforward_associate": 1024,
        "dim_feedforward_filtering": 2048,
        "dropout": 0.1,
        "max_targets": 20
    },
    "data": {
        "task_type": 1,
        "num_train_scenarios": 2000,
        "num_val_scenarios": 200,
        "num_test_scenarios": 200,
        "tau": 4,
        "max_measurements": 30,
        "batch_size": 64,
        "num_workers": 0,
        "crossing_probability": 0.7
    },
    "training": {
        "num_steps": 100000,
        "lr": 0.0001,
        "weight_decay": 1e-05,
        "grad_clip": 1.0,
        "association_weight": 1.0,
        "filtering_weight": 5.0,
        "gamma": 1.0,
        "lr_scheduler": {
            "type": "step",
            "step_size": 200000,
            "gamma": 0.5
        }
    },
    "logging": {
        "log_interval": 100,
        "val_interval": 5000,
        "save_interval": 10000,
        "save_dir": "checkpoints_radar_crossing",
        "log_dir": "logs_radar_crossing"
    },
    "description": "3D雷达场景配置：观测站位于原点，R∈[10000,50000]m，速度100~500m/s，R/alpha/beta三路测量含噪声，50%场景含两两交叉轨迹。"
}
